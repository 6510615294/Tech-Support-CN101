# =============================================================
#  Unified Docker Compose — Environment Variables
# =============================================================
# Copy this to .env and fill in your values before running docker compose up

# ----------------------- App Database -----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# ----------------------- Redis (app) ------------------------
REDIS_PASSWORD=redispassword

# ----------------------- MinIO ------------------------------
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password

# ----------------------- Judge0 Database --------------------
JUDGE0_POSTGRES_DB=judge0
JUDGE0_POSTGRES_USER=judge0
JUDGE0_POSTGRES_PASSWORD=judge0password

# ----------------------- Judge0 Redis -----------------------
JUDGE0_REDIS_PASSWORD=judge0redispassword

# ----------------------- Grafana ----------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ----------------------- Frontend ---------------------------
# Change to your server IP or domain in production, e.g.:
# NEXT_PUBLIC_API_URL=https://your-server-ip:8080/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api
